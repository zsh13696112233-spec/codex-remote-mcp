{
  "agents": {
    "local": {
      "url": "ws://127.0.0.1:4500",
      "cwd": "C:\\work",
      "enabled": true,
      "capabilities": ["supervisor", "executor"],
      "capacity": 1,
      "artifact_root": "C:\\codex-workflow-artifacts",
      "allow_write": true,
      "allow_full_access": true,
      "allow_cwd_override": true
    },
    "supervisor-b": {
      "url": "wss://supervisor-b.internal/codex",
      "cwd": "C:\\codex-workspaces\\supervisor-b",
      "enabled": true,
      "capabilities": ["supervisor"],
      "capacity": 1,
      "token_env": "SUPERVISOR_B_APP_SERVER_TOKEN",
      "orchestration_mode": "remote_sidecar",
      "sidecar_token_env": "SUPERVISOR_B_SIDECAR_TOKEN",
      "allow_write": false,
      "allow_full_access": false,
      "allow_cwd_override": false
    },
    "remote-build": {
      "url": "wss://worker.example.com/codex",
      "cwd": "/srv/work",
      "enabled": true,
      "capabilities": ["executor"],
      "token_env": "REMOTE_CODEX_TOKEN",
      "allow_write": false,
      "allow_full_access": false,
      "allow_cwd_override": false
    }
  }
}
